            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": 4,\n  \"unidadeId\": 1,\n  \"canalPedido\": \"APP\",\n  \"itens\": [\n    {\n      \"produtoUnidadeId\": 1,\n      \"quantidade\": 1\n    }\n  ],\n  \"pontosUtilizados\": 0\n}",
